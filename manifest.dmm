# Include dynamically generated versions list from latest release
$include https://github.com/choco-technologies/todmv/releases/download/vlatest/versions.dmm

# Module entries with version placeholder - will be expanded by $version-available
libtodmv https://github.com/choco-technologies/todmv/releases/download/v<version>/libtodmv-v<version>-<arch_name>.zip
todmv https://github.com/choco-technologies/todmv/releases/download/v<version>/todmv-v<version>-<arch_name>.zip
